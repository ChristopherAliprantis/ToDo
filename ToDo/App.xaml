<Application
    x:Class="ToDo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ToDo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com"
    xmlns:android="http://uno.ui/android"
    xmlns:desktop="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Initializes internal WinUI / Uno Platform control styles -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- "Default" is the theme key mapped strictly to Dark Mode in WinUI -->
                <ResourceDictionary x:Key="Default">
                    <!-- Define your custom SolidColorBrush using your exact RGB (58, 58, 58) -->
                    <SolidColorBrush x:Key="GlobalCustomBorderBrush" Color="#FF3A3A3A" />

                    <!-- 1. ButtonBase (Button, ToggleButton, RepeatButton) -->
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="GlobalCustomBorderBrush" />

                    <!-- 2. TextBox -->
                    <StaticResource x:Key="TextBoxBorderBrush" ResourceKey="GlobalCustomBorderBrush" />

                    <!-- 3. ItemsControl derivatives (ComboBox, ListView, ListBox) -->
                    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ListBoxBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ListViewBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>


</Application>
