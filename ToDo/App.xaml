<Application
    x:Class="ToDo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ToDo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com"
    xmlns:android="http://uno.ui/android"
    xmlns:desktop="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- 1. DARK THEME OVERRIDES ONLY -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="GlobalCustomBorderBrush" Color="#FF3A3A3A" />

                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="TextBoxBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ComboBoxHeaderBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ListBoxBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                    <StaticResource x:Key="ListViewBorderBrush" ResourceKey="GlobalCustomBorderBrush" />

                    <!-- Overrides the shared pointer strictly during Dark Mode -->
                    <StaticResource x:Key="ControlElevationBorderBrush" ResourceKey="GlobalCustomBorderBrush" />
                </ResourceDictionary>

                <!-- 2. LIGHT THEME RE-ANCHORING -->
                <ResourceDictionary x:Key="Light">
                    <!-- Resets the shared pointer back to standard semi-transparent black for Light Mode -->
                    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#0F000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>


</Application>
